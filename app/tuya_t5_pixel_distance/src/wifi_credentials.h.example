/**
 * @file wifi_credentials.h.example
 * @brief Template for local WiFi credentials.
 *
 * Copy this file to wifi_credentials.h (same directory) and fill in your
 * network. wifi_credentials.h is git-ignored so the real credentials never
 * reach the repository.
 */

#ifndef __WIFI_CREDENTIALS_H__
#define __WIFI_CREDENTIALS_H__

#define MQTT_DISPLAY_WIFI_SSID     "your-wifi-ssid"
#define MQTT_DISPLAY_WIFI_PSWD     "your-wifi-password"

#endif /* __WIFI_CREDENTIALS_H__ */
